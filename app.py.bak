from flask import Flask, render_template_string, abort
from flask_socketio import SocketIO, emit

# start flask-app en websocket
app = Flask(__name__)
socketio = SocketIO(app, cors_allowed_origins="*")

# tafel status (voorlopig dict, later JSON-bestand)
# TODO: sla status op in een bestand ipv memory
tables = {i: "idle" for i in range(1, 27)}

# index-pagina (normaal niet gebruikt)
# TODO: voeg hier links toe naar de paginas die wel gebruikt worden
@app.route("/")
def index():
    return "MosselTV server draait!"

# Display (TV) met tafeloverzicht
@app.route("/display")
def display():
    html = """
    <!doctype html>
    <html>
    <head>
        <title>Overzicht tafels</title><ul>
        <style>
            .table {font-size: 2em; margin: 10px; padding: 10px; display: inline-block; width: 150px; text-align: center; border-radius: 10px; }
            .idle {background-color: white; color:black;}
            .almost_ready { background-color: orange; color: black;}
            .ready { background-color: green; color: black}
        </style>
        <script src="/static/js/socket.io.min.js"></script>
    </head>
    <body>
        <h1> Overzicht tafels</h1>
        <div id="tables"></div>
        <script>
            var socket = io();
            
            function updateTables(data){
                var container = document.getElementById('tables');
                container.innerHTML = '';
                for (var table in data){
                    var div = document.createElement('div');
                    div.className = 'table ' + data[table];
                    div.innerText = table
                    container.appendChild(div);
                }
            }
            // vraag bij verbinding meteen status
            socket.on('connect', function(){socket.emit('get_status');});

            // ontvang status updates
            socket.on('status_update', function(data){updateTables(data);});
        </script>
    </body>
    </html>
    """
    return render_template_string(html)

# status instellen (primitief)
# TODO: deftig
@app.route("/set/<int:table>/<status>")
def set_status(table, status):
    if table not in tables:
        return abort(404, description=f"Tafel {table} bestaat niet")
    if status not in ["idle", "almost_ready", "ready"]:
        return abort(400, description="ongeldige status")
    tables[table] = status
    socketio.emit('status_update', tables)
    return f"Tafel {table} status gewijzigd naar {status}"

# update status bij request
@socketio.on('get_status')
def handle_get_status():
    emit('status_update', tables)

# start server (voorlopig enkel op loopback adres)
# TODO: laat ook andere (lokale) adressen toe
if __name__ == "__main__":
    import eventlet
    import eventlet.wsgi
    socketio.run(app, host="127.0.0.1", port=5000, debug=True)
